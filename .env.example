VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: set to true to run the app with seeded demo data and no backend.
VITE_DEMO_MODE=false

# NVIDIA Whisper Large v3 for voice trade logging (server-side only, no VITE_ prefix).
NVIDIA_API_KEY=nvapi-your-key-here

# Artificial delay per service call in demo mode (ms). 0 disables it.
VITE_DEMO_LATENCY_MS=60

# AI Coach: all values below are SERVER ONLY (never add a VITE_ prefix).
# Groq runs chat and spoken replies; NVIDIA_API_KEY above is used for transcription.
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
NVIDIA_ASSISTANT_ASR_LANGUAGE=en-US
# Server authentication falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key

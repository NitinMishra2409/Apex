# Demo still needs a URL-shaped placeholder and a nonempty anon key.
# Replace these with your real project's values for connected mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: set to true to run the app with seeded demo data and no backend.
VITE_DEMO_MODE=false

# Artificial delay per service call in demo mode (ms). 0 disables it.
VITE_DEMO_LATENCY_MS=60

# Voice and AI Coach: all values below are SERVER ONLY (never add a VITE_ prefix).
# One Groq key runs transcription (Whisper), chat and spoken replies (Orpheus).
# Leave blank for a no-key demo (manual journal, checklists, and analytics).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VOICE_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHECKLIST_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=autumn
# Optional dedicated conversation secret; falls back to GROQ_API_KEY if unset.
# ASSISTANT_HISTORY_SECRET=replace-with-a-long-random-secret
# Server authentication falls back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-key

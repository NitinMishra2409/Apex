{
  "regions": ["bom1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/checklist-match.js": {
      "maxDuration": 10,
      "supportsCancellation": true
    },
    "api/speak.js": {
      "maxDuration": 30,
      "supportsCancellation": true
    },
    "api/transcribe.js": {
      "maxDuration": 30,
      "supportsCancellation": true
    }
  }
}
